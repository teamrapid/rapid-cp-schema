{
  "title": "RAPID Tracking Database results file",
  "description": "Frictionless Table Schema for results-file specification v1.1. Checks layout and formats only; cross-row and registry checks are applied by Mendelian at load time.",
  "fields": [
    {"name": "site_code", "type": "string", "constraints": {"required": true, "pattern": "^[a-z0-9_]+$"}},
    {"name": "result_spec_version", "type": "string", "constraints": {"required": true, "enum": ["1.1"]}},
    {"name": "generated_at", "type": "datetime", "constraints": {"required": true}},
    {"name": "cp_name", "type": "string", "constraints": {"required": true, "pattern": "^RAPID[0-9]{6}-[a-z0-9]+(-[a-z0-9]+)*_(L1|L2A|L2B|L3)_v[0-9]+\\.[0-9]+$"}},
    {"name": "run_date", "type": "date", "format": "%Y-%m-%d", "constraints": {"required": true}},
    {"name": "data_snapshot_date", "type": "date", "format": "%Y-%m-%d", "constraints": {"required": true}},
    {"name": "row_type", "type": "string", "constraints": {"required": true, "enum": ["summary", "count"]}},
    {"name": "criterion_id", "type": "string", "constraints": {"pattern": "^[dr][0-9]+$"}},
    {"name": "population_n", "type": "integer", "constraints": {"minimum": 1}},
    {"name": "population_basis", "type": "string", "constraints": {"enum": ["observation_time", "all_persons", "other"]}},
    {"name": "population_basis_note", "type": "string"},
    {"name": "count_value", "type": "integer", "constraints": {"minimum": 0}},
    {"name": "count_status", "type": "string", "constraints": {"required": true, "enum": ["exact", "suppressed"]}}
  ],
  "missingValues": [""]
}
